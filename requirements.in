werkzeug==3.1.6  # CVE-2026-27199, CVE-2026-21860, CVE-2025-66221 (was 3.1.0)

# Transitive native deps forced up to their lowest Python 3.13 (cp313) wheel
# release. At their previous resolved versions these had no cp313 wheel, so the
# slim image would build lz4 from source (fails: no compiler) and silently drop
# google-crc32c/markupsafe to their pure-python fallbacks (losing the native
# acceleration the 3.12 image shipped).
google-crc32c>=1.7.0
lz4>=4.4.3
markupsafe>=3.0.0

# Transitive native deps forced up to their lowest Python 3.14 (cp314) wheel
# release, for the azure image (YET-2254: the MS azure-functions base moved to
# Python 3.14 / Ubuntu 24.04, the only variant that isn't EOL Debian 12). At
# their previous resolved versions these had no cp314 wheel, so the azure pip
# install would fall back to building from sdist and fail (no compiler in the
# image). All three keep cp313 wheels, so the 3.13 stages are unaffected.
bitarray>=3.7.2
pandas>=2.3.3
zstandard>=0.24.0

# clickhouse-connect declares `backports.zstd; python_version < "3.14"` (on 3.14
# it uses the stdlib compression.zstd instead), and backports-zstd itself is
# `requires_python <3.14`. pip-compile runs under 3.13 and drops markers that are
# true for the compiling interpreter, so the marker has to be restated here or
# the lock becomes uninstallable on the 3.14 azure image.
backports-zstd>=1.7.0 ; python_version < "3.14"

# Transitive security pins (rybot vulnfix). Forced up to the first patched
# release so the resolved requirements.txt closes the flagged advisories.
